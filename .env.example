# Copy this file to `.env` in the repo root and fill in your keys:
#   macOS / Linux:  cp .env.example .env
#   Windows:        copy .env.example .env
#
# `.env` is listed in .gitignore. Never commit it and never paste a key
# into an issue, pull request or screenshot.
#
# Check your setup any time with:  python scripts/check_setup.py

# --- JEV (TypeSafe) ---------------------------------------------------------
# Direct API key: https://console.typesafe.ai/keys (waitlist).
# No key? Leave it as is and add --replay to every command: the recorded
# answers in fixtures/ are used instead (see the README).
TYPESAFE_API_KEY=

# Using a gateway instead of a direct key? Set these too. Examples:
#   OpenRouter:        TYPESAFE_BASE_URL=https://openrouter.ai/api
#                      JEV_MODEL=typesafe/jev-1.13
#                      TYPESAFE_API_KEY=<your OpenRouter key>
#   Vercel AI Gateway: TYPESAFE_BASE_URL=<gateway URL>
#                      JEV_MODEL=typesafe-ai/jev
#                      TYPESAFE_API_KEY=<your gateway key>
TYPESAFE_BASE_URL=

# Pin a fixed version so results stay comparable. Avoid "jev-latest" (and
# OpenRouter's "~typesafe/jev-latest"): it changes when TypeSafe ships a new model.
JEV_MODEL=jev-1.13

# --- Gemini (the LLM side) --------------------------------------------------
# Free key: https://aistudio.google.com/apikey
# Did the ADK course? Reuse the GOOGLE_API_KEY value from its .env here.
GEMINI_API_KEY=

# The LLM-only baseline. Thinking is kept "minimal" so the comparison is fair:
# a classification answer doesn't need long reasoning, and thinking adds seconds.
# Set GEMINI_THINKING_LEVEL=default to use the model's own setting instead.
# (Not every model accepts every level, e.g. gemini-3.8-flash rejects "minimal".)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=minimal

# Free-tier Gemini keys allow only a few requests per minute. The course waits
# between calls to stay under this limit (waiting time is never counted as
# latency). Raise it on a paid key.
LLM_REQUESTS_PER_MINUTE=10
